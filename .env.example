# Copy to .env (repo root) and adjust. Both the server and the Vite dev server read it.

# ── Server ────────────────────────────────────────────────
# Port the game server (Express + Socket.IO) listens on.
PORT=3001
# Interface to bind. 0.0.0.0 = all interfaces.
HOST=0.0.0.0
# Comma-separated extra origins allowed to connect. Leave blank when the client is
# served from the same origin (dev proxy or `npm start`), which is the default setup.
CORS_ORIGINS=
# Players per room (clamped to 2–8).
MAX_PLAYERS_PER_ROOM=8
# Maximum simultaneous rooms on this server.
MAX_ROOMS=500
# How long (ms) a disconnected player keeps their seat before removal.
RECONNECT_GRACE_MS=30000
# How long (ms) a disconnected host stays host before the role moves to a connected player.
HOST_HANDOFF_MS=10000
# How long (ms) the drawer has to pick a word before one is picked for them.
WORD_CHOICE_MS=15000
# Length (ms) of the drawing/guessing phase.
ROUND_DRAW_MS=60000
# How long (ms) round results are shown before the match moves on by itself (the host can skip).
ROUND_RESULTS_MS=8000

# ── Client (Vite dev server) ──────────────────────────────
# Set to 0.0.0.0 to open the dev server to phones on the same Wi-Fi network.
DEV_HOST=localhost
CLIENT_PORT=5173
# Optional absolute URL of the game server. Leave blank to use the same origin
# (recommended; Vite proxies /socket.io and /api to PORT in development).
VITE_SERVER_URL=
